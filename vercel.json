{
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "cp -r src/web/public/. public",
  "installCommand": ":",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/story", "destination": "/story.html" },
    { "source": "/game", "destination": "/game.html" },
    { "source": "/map/porto-stellare", "destination": "/map/porto-stellare.html" },
    { "source": "/lore/porto-stellare", "destination": "/lore/porto-stellare.html" },
    { "source": "/sessions/session-1", "destination": "/sessions/session-1.html" },
    { "source": "/oneshot/porto-arrival", "destination": "/oneshot/porto-arrival.html" },
    { "source": "/bestiary", "destination": "/bestiary/index.html" },
    { "source": "/bestiary/detail", "destination": "/bestiary/detail.html" },
    { "source": "/folio/anuchit", "destination": "/folio/anuchit.html" },
    { "source": "/folio/aurora", "destination": "/folio/aurora.html" },
    { "source": "/folio/aython", "destination": "/folio/aython.html" },
    { "source": "/folio/jen", "destination": "/folio/jen.html" },
    { "source": "/folio/kael-veranth", "destination": "/folio/kael-veranth.html" },
    { "source": "/folio/kael-vorn", "destination": "/folio/kael-vorn.html" }
  ]
}
